# PostgreSQL Database Connection
DB_PATH="postgresql://postgres:password@localhost:5432/urlshortener"

# Security & Authentication
SAFE_BROWSING="your-google-safe-browsing-api-key"
JWT_SECRET_KEY="generate-a-secure-random-secret-key"

# Email Delivery (Resend)
RESEND_API_KEY="re_your_resend_api_key"
ADMIN_EMAIL="admin@example.com"

# Local Data Storage Paths
QUOTATIONS_JSON_PATH="data/quotations.json"
SUPPORT_JSON_PATH="data/support_tickets.json"

# Firebase Admin SDK Configuration
FIREBASE_ADMIN_SDK_JSON="config/firebase-service-account.json"

# Razorpay Payments
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Cloudflare for SaaS (Custom Domains)
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
CLOUDFLARE_ZONE_ID="your_cloudflare_zone_id"
CLOUDFLARE_FALLBACK_ORIGIN="fallback-origin.flexurl.app"

# Redis & Analytics Tuning
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
CLICK_FLUSH_INTERVAL=30
CLICK_BATCH_SIZE=1000
GEO_CACHE_TTL=604800
REDIS_LOCK_TIMEOUT=60
GEO_IP_TIMEOUT=2.0
WEBHOOK_TIMEOUT=5.0
